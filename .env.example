    # Copy this file to .env and update values as needed.
    # Toggle default AI behaviour (true/false).
    FILE_ORGANIZER_ENABLE_AI=true

    # Preferred AI provider when AI is enabled (openai, perplexity, mistral).
    FILE_ORGANIZER_AI_PROVIDER=openai

    # Optional overrides.
    FILE_ORGANIZER_AI_SCOPE=fallback
    FILE_ORGANIZER_AI_MODEL=gpt-4o-mini
    FILE_ORGANIZER_AI_TIMEOUT=15

    # API keys - leave blank to rely on runtime args.
    OPENAI_API_KEY=
    PERPLEXITY_API_KEY=your_perplexity_api_key_here
    MISTRAL_API_KEY=your_mistral_api_key_here
